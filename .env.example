# Copy this file to .env and fill in real values. .env is git-ignored; never commit it.
#
# Secret key for Django. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Leave it unset for local development (a development-only key is used while DEBUG is on).
DJANGO_SECRET_KEY=

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) keys, from https://www.google.com/recaptcha/admin
# RECAPTCHA_SITE_KEY is the public "client side integration" key; RECAPTCHA_SECRET_KEY is the
# private "backend calls" key. Feedback submissions are rejected while either is unset.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Production database (Supabase Postgres). Use the pooled "Transaction pooler" connection string
# from Supabase's Connect page. Leave unset locally to keep using db.sqlite3.
DATABASE_URL=

# Optional. DEBUG is on locally and always off on Vercel; set DJANGO_DEBUG=0 or 1 to override.
DJANGO_DEBUG=
# Optional, comma-separated, for a custom domain (*.vercel.app is allowed automatically on Vercel):
#   ALLOWED_HOSTS=library.example.edu.ph
#   CSRF_TRUSTED_ORIGINS=https://library.example.edu.ph
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
